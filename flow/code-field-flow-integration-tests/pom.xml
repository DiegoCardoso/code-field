<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.cardoso</groupId>
        <artifactId>code-field-flow-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>code-field-flow-integration-tests</artifactId>
    <packaging>war</packaging>
    <name>code-field Flow integration tests</name>

    <properties>
        <!-- Never published, and installing it only leaves a stale war in ~/.m2. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <it.port>8890</it.port>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.cardoso</groupId>
            <artifactId>code-field-flow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The whole free component set, so a view can put dc-code-field beside
             vaadin-text-field: alignment against it is a SPEC §14 check. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <!-- F-5: Playwright for Java, not TestBench, which needs a licence to run (SPEC §14.4). -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- `mvn jetty:run` starts the dev server. Vaadin writes package.json,
                 node_modules and the Vite config into this directory; they are
                 generated, ignored, and removed by `mvn clean`. -->
            <plugin>
                <groupId>org.eclipse.jetty.ee10</groupId>
                <artifactId>jetty-ee10-maven-plugin</artifactId>
                <configuration>
                    <httpConnector>
                        <port>${it.port}</port>
                    </httpConnector>
                    <stopPort>8891</stopPort>
                    <stopKey>code-field-it</stopKey>
                    <systemProperties>
                        <!-- Pinned rather than left to Vaadin's default, which switches to
                             hotdeploy when it detects e.g. React views — and hotdeploy hits
                             the websocket reload loop described below. -->
                        <vaadin.frontend.hotdeploy>false</vaadin.frontend.hotdeploy>
                    </systemProperties>
                </configuration>
                <!-- `mvn verify` serves the war around the ITs; `mvn jetty:run` still works
                     for poking at the views by hand. -->
                <executions>
                    <execution>
                        <id>start-jetty</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>stop-jetty</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <it.port>${it.port}</it.port>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <!-- Dev-bundle mode compiles the frontend once and decides whether to
                         rebuild from this app's own dependencies, so an edit under web/src
                         would leave the ITs running a stale component. Deleting both copies
                         of the bundle before every start (jetty:run reaches `initialize`)
                         forces a rebuild from the current sources.

                         Not hotdeploy: under jetty:run every websocket upgrade is dropped
                         right after the 101, so Vite's HMR client reloads the page in a
                         loop. Bundle mode needs no websocket, and the app uses no push. -->
                    <execution>
                        <id>rebuild-dev-bundle</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <!-- override: otherwise Maven merges these element-by-element
                                 with the plugin-level filesets below, and the first one
                                 inherits their `includes` and deletes nothing that matters. -->
                            <filesets combine.self="override">
                                <fileset>
                                    <directory>${project.basedir}/src/main/bundles</directory>
                                </fileset>
                                <fileset>
                                    <directory>${project.build.directory}/dev-bundle</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}</directory>
                            <includes>
                                <include>package*.json</include>
                                <include>vite.config.ts</include>
                                <include>vite.generated.ts</include>
                                <include>types.d.ts</include>
                                <include>tsconfig.json</include>
                                <include>src/main/frontend/index.html</include>
                            </includes>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/node_modules</directory>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/src/main/frontend/generated</directory>
                        </fileset>
                        <fileset>
                            <directory>${project.basedir}/src/main/bundles</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
