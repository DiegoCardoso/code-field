{
  "name": "code-field-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "lint": "npm-run-all --parallel lint:*",
    "lint:js": "eslint",
    "lint:format": "prettier --check \"web/**/*.{js,html}\" \"*.{json,md}\"",
    "format": "prettier --write \"web/**/*.{js,html}\" \"*.{json,md}\"",
    "test": "npm test --workspace web",
    "start": "web-dev-server --node-resolve --open /web/dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@web/dev-server": "^0.4.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
